---
const socials = [
  { name: "GitHub", url: "https://github.com/dani" },
  { name: "Discord", url: "https://discord.com/users/TUID" }
];
---
<section class="stack" aria-labelledby="socials" style="margin-bottom:4rem">
  <h2 id="socials" class="title">Connect with me</h2>
  <div style="display:flex;gap:.75rem;flex-wrap:wrap">
    {socials.map(s => (
      <a class="btn" href={s.url} target="_blank" rel="noopener">{s.name}</a>
    ))}
  </div>
</section>
