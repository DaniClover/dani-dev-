---
const projects = [
  { title: "Project 1", url: "https://github.com/dani/project1", desc: "Short description of the project." },
  { title: "Project 2", url: "https://github.com/dani/project2", desc: "Another cool thing you built." }
];
---
<section class="stack" aria-labelledby="projects" id="projects">
  <h2 id="projects" class="title">Projects</h2>
  <div class="grid cols-2">
    {projects.map(p => (
      <a class="project" href={p.url} target="_blank" rel="noopener">
        <div style="font-weight:700">{p.title}</div>
        <div class="muted" style="margin-top:.3rem">{p.desc}</div>
      </a>
    ))}
  </div>
</section>
