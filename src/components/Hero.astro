---
const bio = `Developer from Dominican Republic 🇩🇴 who loves cars, bats and coding.`;
---
<section class="hero center">
  <div class="stack" style="align-items:center;text-align:center">
    <img class="avatar" src="/images/dani-avatar.png" alt="Dani Avatar" />
    <h1 class="headline">Hi, I'm 🦇 | Dani</h1>
    <p class="muted" style="max-width:680px">{bio}</p>
    <div style="margin-top:.8rem;display:flex;gap:.6rem;flex-wrap:wrap;justify-content:center">
      <span class="tag">Available for collabs</span>
      <a class="btn" href="#projects">View Projects</a>
    </div>
  </div>
</section>
